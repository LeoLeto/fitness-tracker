# MongoDB connection string (kept server-side only, never exposed to the frontend).
# Local example:      mongodb://127.0.0.1:27017/fitness-tracker
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitness-tracker
MONGODB_URI=mongodb://127.0.0.1:27017/fitness-tracker

# Port for the Node/Express server (serves the API and, in production, the built client).
PORT=3001

# NODE_ENV=production enables serving the built client from client/dist.
# Leave unset (or "development") during local development.
# NODE_ENV=production
